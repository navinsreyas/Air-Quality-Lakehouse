{
  "datasets": [
    {
      "name": "7b771bb4",
      "displayName": "regional_trend",
      "queryLines": [
        "SELECT region, month_start, monthly_avg, rolling_12m\r\n",
        "FROM workspace.aq_gold.regional_trend\r\n",
        "WHERE parameter_code = :pollutant\r\n",
        "ORDER BY month_start "
      ],
      "parameters": [
        {
          "displayName": "pollutant",
          "keyword": "pollutant",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "PM2.5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7f27bbc9",
      "displayName": "station_map",
      "queryLines": [
        "SELECT site_name, region, latitude, longitude,\r\n",
        "       ROUND(AVG(daily_avg), 2) AS annual_avg\r\n",
        "FROM workspace.aq_gold.daily_site_summary\r\n",
        "WHERE parameter_code = :pollutant\r\n",
        "  AND year(obs_date) = 2024\r\n",
        "GROUP BY 1, 2, 3, 4"
      ],
      "parameters": [
        {
          "displayName": "pollutant",
          "keyword": "pollutant",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "PM2.5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "0b33deab",
      "displayName": "exceedance_by_year",
      "queryLines": [
        "SELECT year(obs_date) AS yr, parameter_code, count(*) AS exceedance_days\r\n",
        "FROM workspace.aq_gold.exceedance_events\r\n",
        "GROUP BY 1, 2\r\n",
        "ORDER BY 1"
      ]
    },
    {
      "name": "7a3c0113",
      "displayName": "diurnal_profile",
      "queryLines": [
        "SELECT site_name, obs_hour, mean_value\r\n",
        "FROM workspace.aq_gold.site_hourly_profile\r\n",
        "WHERE parameter_code = :pollutant\r\n",
        "  AND region = 'Sydney East'\r\n",
        "ORDER BY site_name, obs_hour"
      ],
      "parameters": [
        {
          "displayName": "pollutant",
          "keyword": "pollutant",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "PM2.5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d4cf25ac",
      "displayName": "completeness",
      "queryLines": [
        "SELECT ROUND(100.0 * (SELECT count(*) FROM workspace.aq_silver.fact_observation)\r\n",
        "                   / (SELECT count(*) FROM workspace.aq_bronze.observations), 2) AS pct_retained"
      ]
    },
    {
      "name": "49db748e",
      "displayName": "fault_vs_event",
      "queryLines": [
        "SELECT event_class, count(*) AS hours\r\n",
        "FROM workspace.aq_gold.hourly_classification\r\n",
        "WHERE event_class NOT IN ('quiet', 'insufficient_network')\r\n",
        "GROUP BY 1\r\n",
        "ORDER BY 2 DESC"
      ]
    },
    {
      "name": "278cfd48",
      "displayName": "jan2020_adaptation",
      "queryLines": [
        "SELECT DATE_TRUNC('DAY', obs_time) AS day,\r\n",
        "       ROUND(AVG(network_mean), 1) AS mean_pm25,\r\n",
        "       MAX(stations_anomalous)     AS stations_flagged\r\n",
        "FROM workspace.aq_gold.hourly_network_state\r\n",
        "WHERE parameter_code = 'PM2.5'\r\n",
        "  AND obs_time >= '2020-01-01' AND obs_time < '2020-02-01'\r\n",
        "GROUP BY 1 ORDER BY 1"
      ]
    }
  ],
